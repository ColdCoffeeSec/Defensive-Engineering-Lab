{"id": "TP-01", "group": "true_positive", "category": "raw_payload", "technique": "raw_semicolon", "description": "Raw ';' appends a second command after ping", "log_format": "nginx_combined", "raw": "203.0.113.5 - - [22/Nov/2026:10:02:11 +0000] \"GET /ping?host=127.0.0.1;id HTTP/1.1\" 200 214 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "203.0.113.5", "cs-uri-stem": "/ping", "cs-uri-query": "host=127.0.0.1;id", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-02", "group": "true_positive", "category": "raw_payload", "technique": "raw_pipe", "description": "Raw '|' pipes ping output into another command", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 203.0.113.7 - - [22/Nov/2026:10:03:40 +0000] \"GET /ping?ip=8.8.8.8|cat%20/etc/passwd HTTP/1.1\" 200 1187 \"-\" \"python-requests/2.32.3\"", "expected_fields": {"c-ip": "203.0.113.7", "cs-uri-stem": "/ping", "cs-uri-query": "ip=8.8.8.8|cat%20/etc/passwd", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-03", "group": "true_positive", "category": "raw_payload", "technique": "raw_command_substitution", "description": "Raw '$(' command substitution", "log_format": "nginx_combined", "raw": "198.51.100.23 - - [22/Nov/2026:10:04:02 +0000] \"GET /ping?ip=$(whoami) HTTP/1.1\" 200 196 \"-\" \"Go-http-client/1.1\"", "expected_fields": {"c-ip": "198.51.100.23", "cs-uri-stem": "/ping", "cs-uri-query": "ip=$(whoami)", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-04", "group": "true_positive", "category": "raw_payload", "technique": "raw_backtick", "description": "Raw backtick command substitution", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 198.51.100.23 - - [22/Nov/2026:10:05:19 +0000] \"GET /ping?ip=8.8.8.8`id` HTTP/1.1\" 200 231 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "198.51.100.23", "cs-uri-stem": "/ping", "cs-uri-query": "ip=8.8.8.8`id`", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-05", "group": "true_positive", "category": "single_url_encoded", "technique": "encoded_semicolon_upper_hex", "description": "Single-encoded ';' (%3B, upper-case hex)", "log_format": "iis_w3c", "iis_fields": "date time s-ip cs-method cs-uri-stem cs-uri-query s-port cs-username c-ip cs(User-Agent) cs(Referer) sc-status sc-substatus sc-win32-status time-taken", "raw": "2026-11-22 10:06:33 10.0.0.20 GET /ping host=127.0.0.1%3Bwhoami 443 - 203.0.113.9 Mozilla/5.0+(X11;+Linux+x86_64;+rv:128.0)+Gecko/20100101+Firefox/128.0 - 200 0 0 1523", "expected_fields": {"c-ip": "203.0.113.9", "cs-uri-stem": "/ping", "cs-uri-query": "host=127.0.0.1%3Bwhoami", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-06", "group": "true_positive", "category": "single_url_encoded", "technique": "encoded_pipe_lower_hex", "description": "Single-encoded '|' (%7c, lower-case hex)", "log_format": "nginx_combined", "raw": "203.0.113.9 - - [22/Nov/2026:10:07:48 +0000] \"GET /ping?host=8.8.8.8%7ccat%20/etc/hosts HTTP/1.1\" 200 402 \"-\" \"python-requests/2.32.3\"", "expected_fields": {"c-ip": "203.0.113.9", "cs-uri-stem": "/ping", "cs-uri-query": "host=8.8.8.8%7ccat%20/etc/hosts", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-07", "group": "true_positive", "category": "single_url_encoded", "technique": "encoded_double_ampersand", "description": "Encoded '&&' (%26%26) stays inside the parameter value and is an effective separator", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 203.0.113.77 - - [22/Nov/2026:10:08:05 +0000] \"GET /ping?ip=8.8.8.8%26%26id HTTP/1.1\" 200 205 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "203.0.113.77", "cs-uri-stem": "/ping", "cs-uri-query": "ip=8.8.8.8%26%26id", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-08", "group": "true_positive", "category": "single_url_encoded", "technique": "encoded_newline", "description": "Encoded newline (%0a) starts a new command; also proves nested endpoint paths match", "log_format": "iis_w3c", "iis_fields": "date time s-ip cs-method cs-uri-stem cs-uri-query s-port cs-username c-ip cs(User-Agent) cs(Referer) sc-status sc-substatus sc-win32-status time-taken", "raw": "2026-11-22 10:09:27 10.0.0.20 GET /api/v1/ping host=1.1.1.1%0aid 443 - 203.0.113.77 curl/8.5.0 - 200 0 0 980", "expected_fields": {"c-ip": "203.0.113.77", "cs-uri-stem": "/api/v1/ping", "cs-uri-query": "host=1.1.1.1%0aid", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-09", "group": "true_positive", "category": "single_url_encoded", "technique": "encoded_command_substitution", "description": "Encoded '$(' (%24%28) command substitution", "log_format": "nginx_combined", "raw": "198.51.100.41 - - [22/Nov/2026:10:10:51 +0000] \"GET /ping?ip=%24%28whoami%29 HTTP/1.1\" 200 190 \"-\" \"Go-http-client/1.1\"", "expected_fields": {"c-ip": "198.51.100.41", "cs-uri-stem": "/ping", "cs-uri-query": "ip=%24%28whoami%29", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-10", "group": "true_positive", "category": "double_url_encoded", "technique": "double_encoded_semicolon", "description": "Double-encoded ';' (%253b), a filter-evasion attempt", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 198.51.100.41 - - [22/Nov/2026:10:12:14 +0000] \"GET /ping?ip=1.1.1.1%253bid HTTP/1.1\" 200 221 \"-\" \"python-requests/2.32.3\"", "expected_fields": {"c-ip": "198.51.100.41", "cs-uri-stem": "/ping", "cs-uri-query": "ip=1.1.1.1%253bid", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-11", "group": "true_positive", "category": "double_url_encoded", "technique": "double_encoded_pipe", "description": "Double-encoded '|' (%257c)", "log_format": "iis_w3c", "iis_fields": "date time s-ip cs-method cs-uri-stem cs-uri-query s-port cs-username c-ip cs(User-Agent) cs(Referer) sc-status sc-substatus sc-win32-status time-taken", "raw": "2026-11-22 10:13:36 10.0.0.20 GET /ping host=1.1.1.1%257cid 443 - 198.51.100.41 curl/8.5.0 - 200 0 0 1104", "expected_fields": {"c-ip": "198.51.100.41", "cs-uri-stem": "/ping", "cs-uri-query": "host=1.1.1.1%257cid", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-12", "group": "true_positive", "category": "evasion", "technique": "ifs_space_substitution_raw", "description": "${IFS} replaces the space to dodge space filters, combined with ';'", "log_format": "nginx_combined", "raw": "203.0.113.120 - - [22/Nov/2026:10:14:59 +0000] \"GET /ping?host=8.8.8.8;cat${IFS}/etc/passwd HTTP/1.1\" 200 1311 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "203.0.113.120", "cs-uri-stem": "/ping", "cs-uri-query": "host=8.8.8.8;cat${IFS}/etc/passwd", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-13", "group": "true_positive", "category": "evasion", "technique": "ifs_space_substitution_encoded_isolated", "description": "Encoded ${IFS} (%24%7b) as the ONLY metacharacter, proving the ${ pattern fires on its own", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 203.0.113.120 - - [22/Nov/2026:10:16:20 +0000] \"GET /ping?host=%24%7bIFS%7dwhoami HTTP/1.1\" 200 188 \"-\" \"Go-http-client/1.1\"", "expected_fields": {"c-ip": "203.0.113.120", "cs-uri-stem": "/ping", "cs-uri-query": "host=%24%7bIFS%7dwhoami", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-14", "group": "true_positive", "category": "param_scope", "technique": "ping_param_other_path_raw", "description": "Parameter named 'ping' on a different path (scope B of the rule)", "log_format": "nginx_combined", "raw": "203.0.113.150 - - [22/Nov/2026:10:17:45 +0000] \"GET /diag?ping=1.1.1.1;id HTTP/1.1\" 200 207 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "203.0.113.150", "cs-uri-stem": "/diag", "cs-uri-query": "ping=1.1.1.1;id", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-15", "group": "true_positive", "category": "param_scope", "technique": "ping_param_not_first_encoded", "description": "'ping' is not the first parameter; encoded pipe inside its value", "log_format": "iis_w3c", "iis_fields": "date time s-ip cs-method cs-uri-stem cs-uri-query s-port cs-username c-ip cs(User-Agent) cs(Referer) sc-status sc-substatus sc-win32-status time-taken", "raw": "2026-11-22 10:19:03 10.0.0.20 GET /diag count=4&ping=1.1.1.1%7Cid 443 - 203.0.113.150 python-requests/2.32.3 - 200 0 0 1240", "expected_fields": {"c-ip": "203.0.113.150", "cs-uri-stem": "/diag", "cs-uri-query": "count=4&ping=1.1.1.1%7Cid", "sc-status": "200"}, "expected_detected": true}
{"id": "TP-16", "group": "true_positive", "category": "scanner_filter_scope", "technique": "non_allowlisted_source_same_payload_as_B06", "description": "Same payload as B-06 from a source OUTSIDE 192.0.2.0/24: the scanner filter must not over-match", "log_format": "nginx_combined", "raw": "198.51.100.77 - - [22/Nov/2026:10:20:30 +0000] \"GET /ping?host=8.8.8.8;id HTTP/1.1\" 200 210 \"-\" \"Mozilla/5.0 zgrab/0.x\"", "expected_fields": {"c-ip": "198.51.100.77", "cs-uri-stem": "/ping", "cs-uri-query": "host=8.8.8.8;id", "sc-status": "200"}, "expected_detected": true}
{"id": "B-01", "group": "benign", "category": "legitimate_traffic", "technique": "legit_ping_param_ip", "description": "Legitimate use: parameter named ping carrying a plain IP", "log_format": "nginx_combined", "raw": "203.0.113.200 - - [22/Nov/2026:10:21:12 +0000] \"GET /ping?ping=8.8.8.8 HTTP/1.1\" 200 198 \"-\" \"Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0\"", "expected_fields": {"c-ip": "203.0.113.200", "cs-uri-stem": "/ping", "cs-uri-query": "ping=8.8.8.8", "sc-status": "200"}, "expected_detected": false}
{"id": "B-02", "group": "benign", "category": "legitimate_traffic", "technique": "legit_host_with_count", "description": "Legitimate multi-parameter request with a hostname", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 203.0.113.201 - - [22/Nov/2026:10:22:40 +0000] \"GET /ping?host=example.com&count=4 HTTP/1.1\" 200 640 \"-\" \"Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0\"", "expected_fields": {"c-ip": "203.0.113.201", "cs-uri-stem": "/ping", "cs-uri-query": "host=example.com&count=4", "sc-status": "200"}, "expected_detected": false}
{"id": "B-03", "group": "benign", "category": "legitimate_traffic", "technique": "legit_health_check_no_query", "description": "Monitoring health check to /ping with no query string (IIS logs an empty query as '-')", "log_format": "iis_w3c", "iis_fields": "date time s-ip cs-method cs-uri-stem cs-uri-query s-port cs-username c-ip cs(User-Agent) cs(Referer) sc-status sc-substatus sc-win32-status time-taken", "raw": "2026-11-22 10:23:05 10.0.0.20 GET /ping - 443 - 10.0.0.5 Zabbix-Agent/7.0 - 200 0 0 12", "expected_fields": {"c-ip": "10.0.0.5", "cs-uri-stem": "/ping", "cs-uri-query": "", "sc-status": "200"}, "expected_detected": false}
{"id": "B-04", "group": "benign", "category": "raw_ampersand_split", "technique": "raw_double_ampersand_path_scope", "description": "Raw unencoded '&&' on /ping: the server splits it into harmless separate parameters", "log_format": "nginx_combined", "raw": "203.0.113.210 - - [22/Nov/2026:10:24:18 +0000] \"GET /ping?host=8.8.8.8&&count=4 HTTP/1.1\" 200 198 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "203.0.113.210", "cs-uri-stem": "/ping", "cs-uri-query": "host=8.8.8.8&&count=4", "sc-status": "200"}, "expected_detected": false}
{"id": "B-05", "group": "benign", "category": "raw_ampersand_split", "technique": "raw_double_ampersand_param_scope", "description": "Raw unencoded '&&' after the ping parameter: 'id' becomes an empty separate parameter, no injection", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 203.0.113.210 - - [22/Nov/2026:10:25:33 +0000] \"GET /diag?ping=8.8.8.8&&id HTTP/1.1\" 200 198 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "203.0.113.210", "cs-uri-stem": "/diag", "cs-uri-query": "ping=8.8.8.8&&id", "sc-status": "200"}, "expected_detected": false}
{"id": "B-06", "group": "benign", "category": "authorized_scanner", "technique": "authorized_scanner_range", "description": "Real payload from the authorized scanner range 192.0.2.0/24 is filtered", "log_format": "nginx_combined", "raw": "192.0.2.10 - - [22/Nov/2026:10:26:50 +0000] \"GET /ping?host=8.8.8.8;id HTTP/1.1\" 200 210 \"-\" \"Mozilla/5.0 zgrab/0.x\"", "expected_fields": {"c-ip": "192.0.2.10", "cs-uri-stem": "/ping", "cs-uri-query": "host=8.8.8.8;id", "sc-status": "200"}, "expected_detected": false}
{"id": "B-07", "group": "benign", "category": "unrelated_endpoint", "technique": "path_ends_in_ping_not_endpoint", "description": "'/shipping' ends in the letters 'ping' but is not the endpoint; no ping parameter", "log_format": "iis_w3c", "iis_fields": "date time s-ip cs-method cs-uri-stem cs-uri-query s-port cs-username c-ip cs(User-Agent) cs(Referer) sc-status sc-substatus sc-win32-status time-taken", "raw": "2026-11-22 10:28:07 10.0.0.20 GET /shipping x=a;b 443 - 203.0.113.230 Mozilla/5.0+(X11;+Linux+x86_64;+rv:128.0)+Gecko/20100101+Firefox/128.0 - 200 0 0 2048", "expected_fields": {"c-ip": "203.0.113.230", "cs-uri-stem": "/shipping", "cs-uri-query": "x=a;b", "sc-status": "200"}, "expected_detected": false}
{"id": "B-08", "group": "benign", "category": "documented_gap", "technique": "other_path_other_param_name", "description": "DOCUMENTED GAP: real payload, but neither path /ping nor a parameter named ping, so the rule does not fire (see TESTING.md)", "log_format": "apache_vhost_combined", "raw": "app.lab.example:443 203.0.113.240 - - [22/Nov/2026:10:29:41 +0000] \"GET /diag?host=1.1.1.1;id HTTP/1.1\" 200 207 \"-\" \"curl/8.5.0\"", "expected_fields": {"c-ip": "203.0.113.240", "cs-uri-stem": "/diag", "cs-uri-query": "host=1.1.1.1;id", "sc-status": "200"}, "expected_detected": false}
